# Spotify (music page). See "Music page setup" in the README.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: Upstash Redis for a full week of listening history.
# Without it, weekly stats only cover Spotify's last 50 plays.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for /api/spotify/sync (also set as a GitHub Actions secret)
CRON_SECRET=
